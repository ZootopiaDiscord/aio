{
  "ReverseProxy": {
    "Routes": {
      "bff": {
        "ClusterId": "bff",
        "Match": {
          "Path": "/bff/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      },
      "login": {
        "ClusterId": "bff",
        "Match": {
          "Path": "/login"
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      },
      "logout": {
        "ClusterId": "bff",
        "Match": {
          "Path": "/logout"
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      },
      "signin": {
        "ClusterId": "bff",
        "Match": {
          "Path": "/signin-oidc"
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      },
      "signout": {
        "ClusterId": "bff",
        "Match": {
          "Path": "/signout-callback-oidc"
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      },
      "rsignout": {
        "ClusterId": "bff",
        "Match": {
          "Path": "/signout-oidc"
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      }
    },
    "Clusters": {
      "bff": {
        "Destinations": {
          "d1": {
            "Address": "http://aio:8080"
          }
        }
      }
    }
  }
}
