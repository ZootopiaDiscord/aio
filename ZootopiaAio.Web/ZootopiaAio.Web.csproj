<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <!--
        This library only ever runs on the server now that the WebAssembly client no longer
        references it, so it can use ASP.NET Core to serve its own content endpoint.
    -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ZootopiaAio.Web.Client\ZootopiaAio.Web.Client.csproj"/>
    </ItemGroup>

    <!-- Copied rather than embedded so the content can be edited, or volume mounted, without a rebuild. -->
    <ItemGroup>
        <Content Update="Content\**" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
