<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <NoDefaultLaunchSettingsFile>True</NoDefaultLaunchSettingsFile>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <AssemblyVersion>0.1.0</AssemblyVersion>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.11"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ZootopiaAio.Bot\ZootopiaAio.Bot.csproj"/>
        <ProjectReference Include="..\ZootopiaAio.Web\ZootopiaAio.Web.csproj"/>
        <ProjectReference Include="..\ZootopiaAio.Web.Client\ZootopiaAio.Web.Client.csproj"/>
    </ItemGroup>

</Project>
