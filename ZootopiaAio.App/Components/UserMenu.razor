<div class="z-50">
    <div class="fixed flex justify-end top-0 left-0 w-full h-full pointer-events-none transition-all duration-500 ease-in-out
        @(_open ? "p-1" : "p-3")">

        <div class="bg-white pointer-events-auto transition-all duration-500 ease-in-out 
                    @(_open
                                            ? "w-full h-full p-4 rounded-2xl inset-ring-2 inset-ring-gray-300 shadow-md"
                                            : "w-18 h-18 p-1 rounded-[2.5rem] inset-ring-4 inset-ring-green-600")">

            <div class="flex flex-col justify-center items-center gap-2">
                <img src="@User.Picture" alt="Discord avatar of @User.Username"
                     class="w-16 h-16 rounded-full cursor-pointer"
                     @onclick="@(() => _open = !_open)"/>

                @if (_open)
                {
                    <div class="animate-fade-in fade-delay-200 text-2xl">@User.Identity?.Name</div>
                }
            </div>
            @if (_open)
            {
                <form action="@($"{BffPaths.Logout}?returnUrl=%2F")" method="post">
                    <button class="fixed bottom-4 left-1/2 -translate-x-1/2 animate-fade-in fade-delay-300"
                            type="submit">Sign out
                    </button>
                </form>
            }
        </div>
    </div>
</div>
