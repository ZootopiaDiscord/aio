@inject NavigationManager Navigation

<ZootButton @onclick="SignIn">Sign in</ZootButton>

@code {

    private void SignIn()
    {
        var returnUrl = $"/{Navigation.ToBaseRelativePath(Navigation.Uri)}";
        Navigation.NavigateTo($"{BffPaths.Login}?returnUrl={Uri.EscapeDataString(returnUrl)}", true);
    }

}
