@page "/debug/claims"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Claims</PageTitle>
<SectionContent SectionName="page-header">Claims</SectionContent>

<AuthorizeView>
    <QuickGrid Items="@DisplayClaims(context.User).AsQueryable()">
        <PropertyColumn Property="@(x => x.Type)" Sortable="true" IsDefaultSortColumn="true"/>
        <PropertyColumn Property="@(x => x.Value)" Sortable="true"/>
    </QuickGrid>
</AuthorizeView>

@code {

    private static IEnumerable<Claim> DisplayClaims(ClaimsPrincipal user)
    {
        return user.Claims.Select(x => x.Type == ClaimTypes.Role
            ? new Claim("role", x.Value, x.ValueType, x.Issuer, x.OriginalIssuer)
            : x);
    }

}