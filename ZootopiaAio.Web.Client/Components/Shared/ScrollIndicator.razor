@*
    Bar pinned to the left edge that jumps to the rules, then back to the top once the page is
    scrolled. It is decoration only below 740px, where the stylesheet takes its pointer events away.
*@

@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<div class="scroll-indicator @(_pointingUp ? "scroll-indicator-up" : null)" @onclick="Jump">
    <div></div>
</div>
@if (_showShadow)
{
    <div class="scroll-indicator-shadow"></div>
}

@code {

    /// <summary>Scroll offset in pixels at which the indicator starts pointing back up.</summary>
    private const int Threshold = 200;

    private IJSObjectReference? _module;
    private DotNetObjectReference<ScrollIndicator>? _selfReference;

    private bool _pointingUp;
    private bool _showShadow = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive)
        {
            return;
        }

        _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", Interop.ModulePath);
        _selfReference = DotNetObjectReference.Create(this);

        // Returns the current state so a reload part way down the page starts out pointing up.
        var scrolled = await _module.InvokeAsync<bool>("watchScroll", _selfReference, Threshold);

        OnScrolled(scrolled);
    }

    /// <summary>
    /// Called from JavaScript whenever the page crosses <see cref="Threshold" />.
    /// </summary>
    [JSInvokable]
    public void OnScrolled(bool scrolled)
    {
        if (_pointingUp == scrolled)
        {
            return;
        }

        _pointingUp = scrolled;

        // The pulsing shadow only exists to draw attention to the indicator before it is first used.
        if (scrolled)
        {
            _showShadow = false;
        }

        StateHasChanged();
    }

    private async Task Jump()
    {
        _showShadow = false;

        if (_module is not null)
        {
            await _module.InvokeVoidAsync(_pointingUp ? "scrollToTop" : "scrollToRules");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stopWatchingScroll");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone, so there is nothing left to clean up.
            }
        }

        _selfReference?.Dispose();
    }

}
